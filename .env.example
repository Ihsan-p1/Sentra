# Copy to .env and fill in. Never commit .env - it is gitignored.

# --- Database ---
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/Sentra1

# --- LLM (OpenAI-compatible endpoint) ---
# Default: local Ollama. No API key required.
# sentra-qwen:3b is built from ollama/Modelfile (qwen2.5:3b with num_ctx 8192).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=sentra-qwen:3b

# Local CPU inference is slow; raise if you hit timeouts.
LLM_TIMEOUT=300

# Fixed seed + low temperature keep evaluation runs reproducible.
LLM_TEMPERATURE=0.3
LLM_SEED=42

# --- API security ---
# When set, POST /api/ingest requires the header  X-API-Key: <value>.
# Leave empty for local development; set it before exposing the server.
# INGEST_API_KEY=

# --- Remote providers (optional) ---
# Only needed when LLM_BASE_URL points somewhere other than localhost.
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
